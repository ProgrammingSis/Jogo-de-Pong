    IC -->|"keyPressed → Player.move()"| Player
    ML -->|"update() → Ball.move()"| Ball
    Ball -->|"collision behind paddle → Score.increment()"| Score
    ML -->|"draw() → Renderer.draw(Model)"| Renderer
    Renderer -->|"uses render utilities"| GameLib
    Player -->|"extends Paddle class"| GameLib
    Ball -->|"extends Ball class"| GameLib
    Score -->|"uses scoring API"| GameLib
    ML -->|"core loop implementation"| GameLib

